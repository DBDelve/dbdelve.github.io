---
import "@/styles/global.css";
import plexWoff2 from "@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url";
import lilexWoff2 from "@fontsource-variable/lilex/files/lilex-latin-wght-normal.woff2?url";

import { SITE } from "@/data/site";
import { jsonLdScript, type SeoMeta } from "@/lib/seo";

interface Props {
  seo: SeoMeta;
}

const { seo } = Astro.props;
const site = Astro.site ?? new URL(SITE.url);
const path = Astro.url.pathname.replace(/\/index\.html$/, "/").replace(/\.html$/, "");
const canonical = seo.noindex ? undefined : (seo.canonicalUrl ?? new URL(path, site).href);
const ogUrl = canonical ?? new URL(path, site).href;
const ogImage = seo.image ? new URL(seo.image.url, site).href : undefined;
const jsonLd = jsonLdScript(seo.structuredData ?? []);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={seo.noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/assets/dbdelve.svg" />
    <link rel="icon" type="image/png" sizes="256x256" href="/assets/dbdelve-256.png" />
    <link rel="apple-touch-icon" href="/assets/dbdelve-256.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={plexWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={lilexWoff2} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={SITE.ogDescription} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {seo.image?.width && <meta property="og:image:width" content={String(seo.image.width)} />}
    {seo.image?.height && <meta property="og:image:height" content={String(seo.image.height)} />}
    {seo.image?.alt && <meta property="og:image:alt" content={seo.image.alt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={SITE.ogDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="generator" content={Astro.generator} />
    <Fragment set:html={jsonLd} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

<style is:global>
  .skip {
    position: fixed;
    left: 1rem;
    top: -4rem;
    z-index: 10;
    padding: 0.6rem 1rem;
    background: var(--color-mint);
    color: var(--color-ink);
    border-radius: var(--radius-sm);
    font-weight: 600;
    text-decoration: none;
  }
  .skip:focus {
    top: 1rem;
  }
</style>
