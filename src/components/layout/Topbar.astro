---
import { LINKS } from "@/data/site";
---

<header class="topbar">
  <a class="brand" href="#surface">
    <img src="/assets/dbdelve.svg" alt="" width="32" height="32" />
    <span>DBDelve</span>
  </a>
  <nav aria-label="Site">
    <a href="#engines">Engines</a>
    <a href="#benchmarks">Benchmarks</a>
    <a href="#install">Install</a>
    <a href={LINKS.repo}>GitHub</a>
  </nav>
</header>

<style is:global>
  /* Sits in the air above the waterline and scrolls away with the page. */
  .topbar {
    position: absolute;
    inset: 0 0 auto;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem var(--gutter);
    color: var(--color-ink);
  }
  .brand {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    color: inherit;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.1rem;
  }
  .brand img {
    border-radius: 8px;
  }
  .topbar nav {
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.75rem);
  }
  .topbar a {
    color: inherit;
  }
  .topbar nav a {
    text-decoration: none;
    font-weight: 500;
  }
  .topbar nav a:hover {
    color: inherit;
    text-decoration: underline;
  }
  .topbar a:focus-visible {
    outline-color: var(--color-ink);
  }
  @media (max-width: 640px) {
    .topbar nav a:not([href="#install"]):not([href^="https"]) {
      display: none;
    }
  }
</style>
