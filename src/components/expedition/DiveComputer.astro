---
// Dive computer: a narrative instrument modelled on a wrist computer's face
// (depth, direction of travel, ocean zone, chapter, and a small dive profile:
// depth against progress through the page). It opens the expedition profile,
// the same profile drawn large with every chapter as a link. Values are
// filled by lib/expedition/diveComputer.ts; without JS the face still opens
// the chapter list.
import { CHAPTERS, zoneOf } from "@/data/chapters";

const pad = (n: number) => String(n).padStart(2, "0");
const fmt = (m: number) => m.toLocaleString("en");
---

<aside class="dc" aria-label="Dive computer">
  <button class="dc__face" type="button" popovertarget="expedition" aria-label="Open the expedition profile" data-dive-computer>
    <span class="dc__row">
      <span class="dc__label" aria-hidden="true">Depth</span>
      <span class="dc__trend" data-dc-trend data-dir="1">
        <span class="dc__arrow" aria-hidden="true"></span><span data-dc-trend-label>Descending</span>
      </span>
    </span>
    <span class="dc__depth"><span data-dc-depth>0</span><small>m</small></span>
    <span class="dc__plot" aria-hidden="true">
      <svg viewBox="0 0 100 32" preserveAspectRatio="none" focusable="false">
        <defs><clipPath id="dc-clip"><rect x="0" y="0" width="0" height="32" data-profile-clip></rect></clipPath></defs>
        <path class="dc__plan" data-profile-plan></path>
        <path class="dc__done" data-profile-done clip-path="url(#dc-clip)"></path>
      </svg>
      <span class="dc__marker"></span>
    </span>
    <span class="dc__row">
      <span class="dc__zone" data-dc-zone>{zoneOf(0)}</span>
      <span class="dc__index" data-dc-index>01/{pad(CHAPTERS.length)}</span>
    </span>
  </button>
</aside>

<div id="expedition" class="map" popover aria-labelledby="expedition-title">
  <div class="map__head">
    <h2 id="expedition-title">Expedition profile</h2>
    <button type="button" popovertarget="expedition" popovertargetaction="hide">Close</button>
  </div>
  <p class="map__note">Depths are narrative: they place each chapter in the dive, they don’t measure anything.</p>
  <div class="map__plot" aria-hidden="true">
    <svg viewBox="0 0 100 32" preserveAspectRatio="none" focusable="false">
      <defs><clipPath id="map-clip"><rect x="0" y="0" width="0" height="32" data-profile-clip></rect></clipPath></defs>
      <path class="dc__plan" data-profile-plan></path>
      <path class="dc__done" data-profile-done clip-path="url(#map-clip)"></path>
      <path class="map__dots" data-profile-dots></path>
    </svg>
    <span class="dc__marker"></span>
  </div>
  <ol class="map__list" aria-label="Chapters">
    {
      CHAPTERS.map((c, i) => (
        <li>
          <a href={`#${c.id}`} data-map-entry aria-current={i === 0 ? "step" : undefined}>
            <span class="map__m">{fmt(c.depth)} m</span>
            <span class="map__dot" aria-hidden="true" />
            <span class="map__title">
              <span class="map__n">{pad(i + 1)}</span> {c.title}
            </span>
            <span class="map__zone">{zoneOf(c.depth)}</span>
          </a>
        </li>
      ))
    }
  </ol>
</div>

<style is:global>
  /* A wrist computer's face: a dark bezel with two side buttons, a recessed
     screen, segment-style mint digits. No ruler: the profile plot is the scale. */
  .dc {
    position: fixed;
    z-index: 5;
    right: 1rem;
    bottom: 1rem;
    width: 9.25rem;
  }
  .dc__face {
    all: unset;
    box-sizing: border-box;
    cursor: pointer;
    position: relative;
    width: 100%;
    display: grid;
    gap: 0.2rem;
    padding: 0.6rem 0.7rem 0.55rem;
    border-radius: 16px;
    color: var(--color-text);
    background:
      radial-gradient(120% 80% at 30% 0%, rgb(95 224 208 / 0.09), transparent 60%),
      linear-gradient(rgb(6 30 34 / 0.92), rgb(2 13 17 / 0.94));
    border: 1px solid rgb(191 230 255 / 0.2);
    box-shadow:
      inset 0 0 0 3px rgb(0 0 0 / 0.45),
      inset 0 1px 0 4px rgb(191 230 255 / 0.05),
      0 14px 36px rgb(0 0 0 / 0.45);
    backdrop-filter: blur(8px);
    transition: border-color 0.2s;
  }
  /* The two side buttons of the bezel. */
  .dc__face::before,
  .dc__face::after {
    content: "";
    position: absolute;
    top: 34%;
    width: 4px;
    height: 18px;
    border-radius: 2px;
    background: rgb(191 230 255 / 0.22);
  }
  .dc__face::before {
    left: -5px;
  }
  .dc__face::after {
    right: -5px;
    top: 52%;
  }
  .dc__face:hover {
    border-color: rgb(95 224 208 / 0.55);
  }
  .dc__face:focus-visible {
    outline: 2px solid var(--color-mint);
    outline-offset: 4px;
  }
  .dc__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.4rem;
  }
  .dc__label,
  .dc__trend,
  .dc__zone,
  .dc__index {
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-2);
    line-height: 1.2;
    white-space: nowrap;
  }
  .dc__index {
    font-family: var(--font-mono);
    letter-spacing: 0;
  }
  .dc__trend {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--color-mint);
  }
  /* Chevron: points down while descending, up while ascending; a level bar when hovering. */
  .dc__arrow {
    width: 7px;
    height: 7px;
    border: solid currentColor;
    border-width: 0 1.6px 1.6px 0;
    rotate: 45deg;
    translate: 0 -2px;
    transition:
      rotate 0.35s var(--ease-out),
      translate 0.35s var(--ease-out),
      border-width 0.2s,
      height 0.2s;
  }
  .dc__trend[data-dir="-1"] .dc__arrow {
    rotate: 225deg;
    translate: 0 2px;
  }
  .dc__trend[data-dir="0"] .dc__arrow {
    rotate: 0deg;
    translate: 0;
    height: 0;
    border-width: 0 0 1.6px;
    width: 8px;
  }
  .dc__trend[data-dir="0"] {
    color: var(--color-text-2);
  }
  .dc__depth {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1.7rem;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--color-mint);
    text-shadow: 0 0 12px rgb(95 224 208 / 0.35);
  }
  .dc__depth small {
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--color-text-2);
    margin-left: 0.2rem;
    text-shadow: none;
  }
  .dc__plot,
  .map__plot {
    position: relative;
    display: block;
    height: 1.6rem;
    margin: 0.15rem 0 0.1rem;
  }
  .dc__plot svg,
  .map__plot svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .dc__plan,
  .dc__done,
  .map__dots {
    fill: none;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .dc__plan {
    stroke: rgb(191 230 255 / 0.22);
    stroke-width: 1;
    stroke-dasharray: 2 2;
  }
  .dc__done {
    stroke: var(--color-mint);
    stroke-width: 1.5;
  }
  .dc__marker {
    position: absolute;
    left: var(--px, 0%);
    top: var(--py, 3%);
    width: 7px;
    height: 7px;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--color-foam);
    box-shadow:
      0 0 0 3px rgb(191 230 255 / 0.16),
      0 0 10px var(--color-foam);
  }
  html:not(.js) .dc__plot,
  html:not(.js) .map__plot,
  html:not(.js) .dc__trend {
    visibility: hidden;
  }

  /* expedition profile */
  .map {
    margin: 0;
    inset: 0 0 0 auto;
    height: 100dvh;
    max-height: none;
    width: min(25rem, 100vw);
    padding: 1.5rem;
    border: 0;
    border-left: 1px solid var(--color-line);
    background: rgb(2 14 19 / 0.92);
    color: var(--color-text);
    backdrop-filter: blur(14px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .map::backdrop {
    background: rgb(0 0 0 / 0.35);
  }
  .map__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .map__head h2 {
    font-size: var(--step-1);
    font-weight: 500;
    margin: 0;
  }
  .map__head button {
    font: inherit;
    color: var(--color-text);
    background: none;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    padding: 0.4rem 1rem;
    cursor: pointer;
    min-height: 36px;
  }
  .map__note {
    font-size: var(--step--1);
    color: var(--color-text-2);
    margin: 1rem 0 1.25rem;
  }
  .map__plot {
    height: 5.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    border-bottom: 1px solid var(--color-line);
  }
  .map__dots {
    stroke: var(--color-text-2);
    stroke-width: 6;
  }
  .map__n {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-2);
    margin-right: 0.25rem;
  }
  .map__list {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .map__list::before {
    content: "";
    position: absolute;
    left: 4.6rem;
    top: 0.8rem;
    bottom: 0.8rem;
    width: 1px;
    background: linear-gradient(var(--color-air-2), var(--color-surface), var(--color-twilight) 60%, var(--color-mint));
  }
  .map__list a {
    display: grid;
    grid-template-columns: 4rem 1.25rem 1fr;
    align-items: center;
    gap: 0 0.6rem;
    padding: 0.55rem 0;
    color: var(--color-text);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .map__list a:hover .map__title {
    text-decoration: underline;
  }
  .map__m {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-align: right;
    color: var(--color-text-2);
    font-variant-numeric: tabular-nums;
  }
  .map__dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: 1px solid var(--color-text-2);
    background: var(--color-abyss);
    justify-self: center;
    position: relative;
  }
  .map__list a[aria-current="step"] .map__dot {
    background: var(--color-mint);
    border-color: var(--color-mint);
    box-shadow: 0 0 10px var(--color-mint);
  }
  .map__title {
    font-weight: 500;
  }
  .map__zone {
    grid-column: 3;
    font-size: 0.78rem;
    color: var(--color-text-2);
  }

  @media (max-width: 959px) {
    .dc {
      width: auto;
      right: 0.75rem;
      bottom: 0.75rem;
    }
    .dc__face {
      grid-template-columns: auto auto;
      align-items: center;
      gap: 0 0.6rem;
      padding: 0.45rem 0.7rem;
      border-radius: 12px;
    }
    .dc__face::before,
    .dc__face::after {
      display: none;
    }
    .dc__row:first-child {
      grid-column: 2;
      grid-row: 1;
    }
    .dc__label,
    .dc__plot,
    .dc__row:last-child,
    .dc__trend span:last-child {
      display: none;
    }
    .dc__depth {
      font-size: 1.15rem;
      grid-row: 1;
      grid-column: 1;
    }
  }
</style>
